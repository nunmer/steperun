# Copy to web/.env.local. Production values live in the Vercel project `steperun`.
# Every variable is explained in docs/DEPLOYMENT.md.

# Supabase: server-side (service role, never exposed to the browser)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Supabase: browser (auth + signed video uploads)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Strava OAuth (profile claims)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3000/api/auth/strava/callback
SECRET_KEY=any-long-random-string

# Run analyzer: local service (cd run_analyzer && uv run uvicorn web:app --port 8000)
# or https://steperun-analyzer.vercel.app with the shared key
RUN_ANALYZER_API_URL=http://localhost:8000
RUN_ANALYZER_API_KEY=

# Paddle coin packs: leave unset for earn-only mode
# PADDLE_CLIENT_TOKEN=
# PADDLE_ENVIRONMENT=sandbox
# PADDLE_WEBHOOK_SECRET=
# PADDLE_PRICE_ID_PACK_10=
# PADDLE_PRICE_ID_PACK_50=
# PADDLE_PRICE_ID_PACK_200=
